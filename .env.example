# MyPaiOS — Environment Configuration
# Copy this file to .env and fill in your values.
#
# Everything here is optional: MyPaiOS boots with safe defaults (embedded
# vector store, local Ollama discovery, auth enabled, loopback-only bind).
# Most integration settings (email accounts, search API keys) can instead be
# managed in the Settings UI — env vars act as the fallback/bootstrap layer.
#
# Naming note: env vars keep the historical PAIOS_* prefix on purpose —
# renaming them would break existing installs. See CONTRIBUTING.md.

# ============================================================
# LLM Configuration
# ============================================================

# Primary LLM host scanned for local model servers (default: localhost)
LLM_HOST=localhost

# Additional LLM hosts, comma-separated (for model discovery).
# Hostnames/IPs only; MyPaiOS scans common serve ports, including Ollama's 11434.
# LLM_HOSTS=llm-host.local,backup-llm.local

# Optional Ollama base URL. In Docker, host Ollama is usually reachable here
# when started with OLLAMA_HOST=0.0.0.0:11434.
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# Legacy alias for the same setting (checked after OLLAMA_BASE_URL):
# OLLAMA_URL=http://localhost:11434

# Optional LM Studio URL. In Docker, host LM Studio is reachable here
# when LM Studio is set to serve on all interfaces (0.0.0.0).
# LM_STUDIO_URL=http://host.docker.internal:1234

# OpenAI API key (only needed if using OpenAI models).
# Do not commit real keys. Keep this commented until needed.
# OPENAI_API_KEY=your_openai_api_key_here

# Research service LLM endpoint
# RESEARCH_LLM_ENDPOINT=http://localhost:8000/v1/chat/completions

# Hard ceiling (seconds) on non-streaming API requests, so one hung call
# can't lock up the server; streaming/long-job routes are exempt (default: 45).
# REQUEST_HARD_TIMEOUT=45

# Extra CA bundle for LLM providers whose TLS chain isn't in the default
# trust store. Layered ON TOP of the system / certifi bundle — verification
# stays on for every host, the trust set just gets larger. Useful for
# on-premise / corporate LLM gateways with an internal CA.
# Point at a PEM file containing the missing root(s).
# LLM_CA_BUNDLE=/path/to/ca/extra-roots.pem

# Ollama's own tuning knobs (read by the Ollama server, surfaced in the
# Cookbook tab). Set these in Ollama's environment, not here, unless you
# launch Ollama from the same shell:
# OLLAMA_MODELS=~/.ollama/models      # where Ollama stores model blobs
# OLLAMA_NUM_PARALLEL=2               # concurrent requests per loaded model
# OLLAMA_MAX_LOADED_MODELS=3          # models kept in memory at once
# OLLAMA_MAX_QUEUE=512                # queued requests before 503

# ============================================================
# Search & Web
# ============================================================

# SearXNG instance URL (self-hosted, for web search).
# Docker Compose overrides this to http://searxng:8080 for in-network access.
SEARXNG_INSTANCE=http://localhost:8080

# Optional SearXNG cookie/CSRF secret. If blank, Docker generates one on first boot
# and stores it in the searxng-data volume.
# SEARXNG_SECRET=

# Engines SearXNG queries for general web search (default: bing,mojeek,presearch).
# SEARXNG_GENERAL_ENGINES=bing,mojeek,presearch

# Hosted search provider API keys (all optional — prefer the Settings UI,
# which stores them encrypted; env vars are the fallback). Do not commit keys.
# DATA_BRAVE_API_KEY=            # Brave Search API
# TAVILY_API_KEY=                # Tavily
# SERPER_API_KEY=                # Serper.dev (Google results)
# GOOGLE_API_KEY=                # Google Programmable Search Engine key...
# GOOGLE_PSE_CX=                 # ...and its engine ID (cx)

# ============================================================
# Database & Data
# ============================================================

# SQLite database path (default: sqlite:///./data/app.db)
# DATABASE_URL=sqlite:///./data/app.db

# Root directory for app data — DB, uploads, model caches (default: data).
# DATA_DIR=data

# ============================================================
# Auth & Security
# ============================================================

# Enable authentication (default: true)
# AUTH_ENABLED=true

# Host bind address and port for the MyPaiOS web UI in Docker Compose.
# Keep APP_BIND on loopback unless you intentionally want LAN/reverse-proxy access.
# APP_BIND=127.0.0.1
# Change this if another local service already uses 7000 (macOS AirPlay often does).
# APP_PORT=7000

# Native (non-Docker) launch overrides used by start-macos.sh and the deploy
# templates. Native default port is 7860 (7000 collides with macOS AirPlay).
# PAIOS_PORT=7860
# PAIOS_HOST=127.0.0.1

# ── DEV-ONLY, DANGEROUS ─────────────────────────────────────
# LOCALHOST_BYPASS skips ALL authentication for requests arriving from
# loopback. Anyone (or any process) on the machine gets full access, and a
# reverse proxy on the same host would grant it to the whole network.
# Development convenience only. Keep false for Docker, LAN, reverse proxy,
# and any shared deployment. Default: false.
# LOCALHOST_BYPASS=false

# Mark session cookies Secure. Set true when MyPaiOS is served through HTTPS
# by a trusted reverse proxy or private access gateway.
# SECURE_COOKIES=true

# Optional: pre-seed the first admin account during setup.
# Do not commit a real password.
# PAIOS_ADMIN_USER=admin
# PAIOS_ADMIN_PASSWORD=change_me_before_first_boot
# Non-interactive setup.py runs: skip the admin prompt / the "how to run" hint.
# PAIOS_SKIP_ADMIN_PROMPT=1
# PAIOS_SKIP_RUN_HINT=1

# CORS allowed origins (default: localhost-only; restrict to your public origin in production)
# ALLOWED_ORIGINS=http://localhost:7000,http://localhost:8000

# Session lifetimes in days (defaults: 7, and 90 with "remember me").
# PAIOS_SESSION_TTL_DAYS=7
# PAIOS_REMEMBER_ME_DAYS=90

# Single-user mode for calendar/notes ownership (default: 1). Set 0 on a
# multi-account install so records stay scoped per user.
# PAIOS_SINGLE_USER=1
# Owner id assigned to legacy/unowned calendar records (default: owner@localhost).
# PAIOS_FALLBACK_OWNER=owner@localhost

# Shared secret for internal tool calls between app components.
# Auto-generated at startup when unset — only pin it for multi-process setups.
# PAIOS_INTERNAL_TOKEN=

# Public base URL of this install (used to build OAuth redirect URLs for
# remote MCP connectors). OAUTH_REDIRECT_BASE_URL wins over APP_PUBLIC_URL.
# APP_PUBLIC_URL=https://my-paios.example.com
# OAUTH_REDIRECT_BASE_URL=https://my-paios.example.com

# ============================================================
# ChromaDB (vector store)
# ============================================================

# Storage mode (default: embedded).
#   embedded — in-process persistent store under CHROMADB_PATH. No extra
#              service to run; this is what single-machine installs want.
#   http     — connect to a standalone ChromaDB service (CHROMADB_HOST/PORT).
# CHROMADB_MODE=embedded

# Where the embedded store persists its data (default: <DATA_DIR>/chroma).
# CHROMADB_PATH=data/chroma

# Standalone service address — only read when CHROMADB_MODE=http.
# Manual host run: localhost:8100 when using `docker run -p 8100:8000 chromadb/chroma`.
# Docker Compose overrides these to chromadb:8000 for in-network access.
# CHROMADB_HOST=localhost
# CHROMADB_PORT=8100

# Fast-fail TCP probe timeout in seconds when checking a remote ChromaDB (default: 2.0).
# CHROMADB_CONNECT_TIMEOUT=2.0

# Docker Compose host-port bind addresses for bundled services.
# Defaults are loopback-only for safety. To expose ntfy only on Tailscale,
# set NTFY_BIND to your host's Tailscale IP and update NTFY_BASE_URL.
# CHROMADB_BIND=127.0.0.1
# NTFY_BIND=127.0.0.1
# NTFY_BASE_URL=http://localhost:8091
# Example:
# NTFY_BIND=100.x.y.z
# NTFY_BASE_URL=http://100.x.y.z:8091

# ============================================================
# RAG / Embeddings
# ============================================================

# Embedding API endpoint (OpenAI-compatible /v1/embeddings)
# Default: http://{LLM_HOST}:11434/v1/embeddings (ollama)
# EMBEDDING_URL=http://localhost:11434/v1/embeddings

# Embedding API key (if there's one)
# EMBEDDING_API_KEY=embedding_api_key_here

# Embedding model name (must be available at the endpoint above)
# EMBEDDING_MODEL=all-minilm:l6-v2

# Local fallback embedding model (used when no HTTP embedding API is available)
# Uses fastembed (ONNX) — downloads model on first run (~50MB)
# FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# FASTEMBED_CACHE_PATH=  # defaults to ~/.cache/fastembed

# SSRF guard: refuse embedding endpoints that resolve to private IPs.
# Default false because the normal setup IS a private/loopback endpoint
# (local Ollama). Set true if the endpoint should only ever be public.
# EMBEDDING_BLOCK_PRIVATE_IPS=false

# ============================================================
# Email (Mail tab) — prefer adding accounts in Settings → Email;
# these env vars are the legacy single-account fallback.
# ============================================================

# SMTP_HOST=smtp.example.com
# SMTP_PORT=465                  # default 465 (implicit TLS)
# SMTP_USER=you@example.com
# SMTP_PASSWORD=                 # do not commit real credentials
# SMTP_SECURITY=                 # ssl | starttls | none (blank = infer from port)
# IMAP_HOST=imap.example.com
# IMAP_PORT=993                  # default 993 (implicit TLS)
# IMAP_USER=you@example.com
# IMAP_PASSWORD=
# EMAIL_FROM=you@example.com     # From: address for outgoing mail

# TLS toggles for the email MCP server (defaults shown).
# IMAP_SSL=false                 # implicit TLS on connect
# IMAP_STARTTLS=true             # upgrade plain connection via STARTTLS
# SMTP_SSL=true                  # implicit TLS on connect
# SMTP_STARTTLS=false            # upgrade plain connection via STARTTLS

# IMAP socket timeout in seconds, clamped to 5-300 (default: 30).
# PAIOS_IMAP_TIMEOUT_SECONDS=30
# Socket timeout for the email MCP server (default: 20).
# EMAIL_SOCKET_TIMEOUT=20
# IMAP folder names used by archive/delete actions (defaults: Archive, Trash).
# ARCHIVE_FOLDER=Archive
# TRASH_FOLDER=Trash
# Where fetched attachments are stored (default: <DATA_DIR>/mail-attachments).
# PAIOS_MAIL_ATTACHMENTS_DIR=data/mail-attachments

# ============================================================
# Calendar & Contacts (CalDAV / CardDAV)
# ============================================================

# CardDAV server for contact sync (prefer Settings UI; env is the fallback).
# CARDDAV_URL=https://dav.example.com/contacts/
# CARDDAV_USERNAME=
# CARDDAV_PASSWORD=
# SSRF guard: refuse CardDAV servers on private IPs (default: false —
# self-hosted DAV servers on the LAN are the common case).
# CARDDAV_BLOCK_PRIVATE_IPS=false

# Allow CalDAV sync against private/LAN addresses (default: 0 = blocked).
# Set 1 for a self-hosted Radicale/Nextcloud on your own network.
# PAIOS_ALLOW_PRIVATE_CALDAV=0

# ============================================================
# Uploads, Files & Documents
# ============================================================

# Upload size caps in bytes (defaults shown).
# PAIOS_PERSONAL_UPLOAD_MAX_BYTES=26214400            # personal docs, 25 MB
# PAIOS_GALLERY_UPLOAD_MAX_BYTES=104857600            # gallery media, 100 MB
# PAIOS_GALLERY_TRANSFORM_UPLOAD_MAX_BYTES=26214400   # gallery edits, 25 MB
# PAIOS_MEMORY_IMPORT_MAX_BYTES=10485760              # memory import, 10 MB

# SSRF guard: block image fetches from private IPs when importing by URL
# (default: false).
# IMAGE_BLOCK_PRIVATE_IPS=false

# Extra directories (comma-separated) indexed for the personal-docs RAG,
# beyond the built-in data/personal root.
# PAIOS_DOC_ROOTS=/path/to/notes,/path/to/papers

# Obsidian vault to expose to the assistant (default: auto-detect).
# PAIOS_OBSIDIAN_VAULT=/path/to/vault

# File-index safety caps: max entries and per-root scan timeout in seconds.
# PAIOS_FILE_INDEX_MAX=400000
# PAIOS_FILE_INDEX_ROOT_TIMEOUT=15

# PDF text-extraction engine: docling (default) or pypdf.
# PAIOS_PDF_ENGINE=docling

# ============================================================
# Voice, Media & Local Models
# ============================================================

# Where the Kokoro TTS model files live (default: data/models/kokoro).
# PAIOS_KOKORO_DIR=data/models/kokoro

# Hugging Face cache/auth for model downloads (standard HF variables; other
# HF_HUB_* knobs like HUGGINGFACE_HUB_CACHE, HF_HUB_DOWNLOAD_MAX_WORKERS and
# HF_HUB_DISABLE_PROGRESS_BARS are honored too).
# HF_HOME=~/.cache/huggingface
# HF_TOKEN=                      # or HUGGING_FACE_HUB_TOKEN

# Local image-generation server (scripts/flux_server.py).
# FLUX_PORT=7801
# FLUX_MODEL_ID=z-image-turbo    # HF model id, or a friendly alias
# FLUX_FAMILY=z_image            # z_image | flux
# FLUX_QUANTIZE=4                # bits; lower = less VRAM, more artifacts
# FLUX_MODEL_PATH=               # optional local checkpoint path
# FLUX_BASE_MODEL=schnell        # flux family: schnell | dev

# ============================================================
# Misc / Operations
# ============================================================

# Log level for the CLI scripts under scripts/ (default: WARNING).
# LOG_LEVEL=WARNING

# Periodic cleanup of expired sessions/temp artifacts (defaults: on, every 24h).
# CLEANUP_ENABLED=true
# CLEANUP_INTERVAL_HOURS=24

# In-process email pollers (default: on). Set to 0 if you're driving
# polling from cron / systemd via `scripts/paios-mail poll-scheduled`
# and `scripts/paios-mail poll-summary`, otherwise both schedulers
# race on the same SQLite.
# PAIOS_INPROCESS_POLLERS=1

# In-process scheduled-task runner (default: on). Set to 0 to let an
# external driver fire scheduled tasks. Calendar reminders are
# frontend-driven (polling /api/notes from the browser) so no gate is
# needed there.
# PAIOS_INPROCESS_TASKS=1

# Host used by the built-in "run_script" scheduled-task action.
# Empty/local/localhost runs scripts on the app host. Set to an SSH host alias
# if you intentionally want scheduled scripts to run remotely.
# PAIOS_SCRIPT_HOST=localhost

# Disable the built-in MCP tool servers entirely (default: enabled).
# PAIOS_DISABLE_MCP=false

# For external agent integrations (integrations/claude, integrations/codex):
# where those CLI scripts find this app and how they authenticate.
# PAIOS_URL=http://localhost:7860
# PAIOS_API_TOKEN=               # create one in Settings → API Tokens

# Developer/demo tooling only: scripts/demo_email/seed_demo_emails.py reads
# DEMO_IMAP_HOST/PORT/USER/PASSWORD for a throwaway seed mailbox, and
# refuses to wipe a non-demo mailbox unless DEMO_ALLOW_WIPE=1. Not used by
# the app itself — leave unset.

# ============================================================
# GPU support (Docker Compose)
# ============================================================
# Pass the host GPU into the app container. Default (unset) = CPU.
# COMPOSE_FILE is a native `docker compose` feature: a colon-separated
# list of files merged left-to-right. Pick ONE GPU line below, or leave
# all commented for CPU.
#
# NVIDIA (requires nvidia-container-toolkit + `nvidia-ctk runtime
# configure --runtime=docker` on the host):
# COMPOSE_FILE=docker-compose.yml:docker/gpu.nvidia.yml
# COMPOSE_FILE=docker-compose.yml;docker/gpu.nvidia.yml    #(Windows)
#
# AMD ROCm (requires ROCm drivers on the host and the GID of the render group):
# COMPOSE_FILE=docker-compose.yml:docker/gpu.amd.yml
# Find the render GID with: getent group render | cut -d: -f3
# RENDER_GID=989
#
# These overlays only expose the GPU devices. The slim app image
# still needs CUDA/ROCm userspace via Cookbook -> Dependencies (vLLM,
# llama-cpp-python, etc.) before models can actually serve on GPU.
